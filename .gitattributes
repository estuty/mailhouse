# Kept out of the release zip. The workflow builds it with `git archive`, and
# a plugin folder on somebody's server has no use for our CI, our test suites
# (which run against whatever database they find) or our design documents.
/.github             export-ignore
/.gitattributes      export-ignore
/tests               export-ignore
/docs/audit          export-ignore
/docs/architecture   export-ignore

# The protocol's worked examples are compared with the centre's copy byte for
# byte. A checkout must never give them another line ending.
/tests/fixtures/*.json -text
